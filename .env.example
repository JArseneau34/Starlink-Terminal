# SPCX API Server — copy to .env and fill in values

PORT=3002

# Finnhub — free at https://finnhub.io/register (60 REST/min + WebSocket trades)
FINNHUB_API_KEY=

# Marketaux — optional, free at https://www.marketaux.com (sentiment + entity tagging)
MARKETAUX_API_KEY=

# Launch Library 2 — optional Patreon key from https://thespacedevs.com/supportus
LL2_API_KEY=

LL2_USE_DEV=false
NASA_API_KEY=DEMO_KEY

# ── Quote speed (all free except Finnhub key) ─────────────────────────────
# Yahoo batch: all symbols in 1–2 requests, no key required
YAHOO_BATCH_MS=4000

# Finnhub REST: only polls symbols stale > FINNHUB_STALE_MS (saves API budget)
TURBO_POLL_MS=1200
FINNHUB_STALE_MS=20000
FINNHUB_REST_BUDGET_PER_MIN=45

# Client polls server memory (no external API cost)
TURBO_CLIENT_POLL_MS=250

# Cache TTLs (ms) — quotes cache is fallback; live stream is in-memory
CACHE_TTL_QUOTES=15000
CACHE_TTL_LAUNCHES=300000
CACHE_TTL_NEWS=180000
CACHE_TTL_TERMINAL=20000

# News wire — merged headline cap and per-source fetch limits
NEWS_MERGE_LIMIT=100
NEWS_SNAPI_SITES_LIMIT=40
NEWS_MARKETAUX_LIMIT=50
NEWS_FINNHUB_COMPANY_LIMIT=8
