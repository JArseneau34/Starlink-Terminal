{
  "name": "spcx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,amber \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "sync:pipeline": "node scripts/sync-pipeline.mjs",
    "verify:layer1": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/verifyLayer1.ts",
    "verify:layer2": "node ./node_modules/tsx/dist/cli.mjs scripts/verifyLayer2.ts",
    "verify:live-shells": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/verifyLiveShells.ts",
    "verify:topology": "npm run verify:layer2",
    "verify:layers": "npm run verify:live-shells && npm run verify:layer1 && npm run verify:layer2",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "satellite.js": "^7.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
